{
  "name": "material-symbols-framework",
  "version": "0.0.1",
  "private": true,
  "description": "Material Symbols icon library with first-class support for popular frameworks.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "clean": "pnpm -r --filter \"./packages/*\" run clean"
  },
  "devDependencies": {
    "@vue/server-renderer": "^3.5.34",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.9.0",
    "preact-render-to-string": "^6.6.7",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@angular/core",
      "vue"
    ]
  }
}
{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "declaration": true,
        "declarationMap": false,
        "sourceMap": false,
        "removeComments": false,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true
    }
}
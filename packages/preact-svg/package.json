{
  "name": "@material-symbols-framework/preact-svg",
  "version": "0.0.2",
  "description": "Material Symbols icons for Preact, rendered as inline SVG.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/rounded/index.js",
  "types": "./dist/types/rounded/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/rounded/index.d.ts",
      "import": "./dist/esm/rounded/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./rounded": {
      "types": "./dist/types/rounded/index.d.ts",
      "import": "./dist/esm/rounded/index.js"
    },
    "./outlined": {
      "types": "./dist/types/outlined/index.d.ts",
      "import": "./dist/esm/outlined/index.js"
    },
    "./sharp": {
      "types": "./dist/types/sharp/index.d.ts",
      "import": "./dist/esm/sharp/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist src/outlined src/rounded src/sharp",
    "generate": "node ../../scripts/generate.mjs preact-svg",
    "build": "node build.mjs"
  },
  "peerDependencies": {
    "preact": ">=10"
  },
  "devDependencies": {
    "preact-render-to-string": "^6.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heliacn/material-symbols-framework.git",
    "directory": "packages/preact-svg"
  },
  "bugs": {
    "url": "https://github.com/heliacn/material-symbols-framework/issues"
  },
  "homepage": "https://github.com/heliacn/material-symbols-framework/tree/main/packages/preact-svg#readme",
  "publishConfig": {
    "access": "public"
  },
  "author": "heliacn",
  "keywords": [
    "icons",
    "material-symbols",
    "material-design",
    "icon-library",
    "preact",
    "preact-svg"
  ]
}

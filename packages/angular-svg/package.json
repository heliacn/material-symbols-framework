{
  "name": "@material-symbols-framework/angular-svg",
  "version": "0.0.2",
  "description": "Material Symbols icons for Angular, rendered as inline SVG.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/fesm2022/index.mjs",
  "module": "./dist/fesm2022/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/fesm2022/index.mjs"
    },
    "./icons/*": "./dist/icons/*.mjs"
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node build.mjs"
  },
  "peerDependencies": {
    "@angular/core": ">=16",
    "@angular/common": ">=16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heliacn/material-symbols-framework.git",
    "directory": "packages/angular-svg"
  },
  "bugs": {
    "url": "https://github.com/heliacn/material-symbols-framework/issues"
  },
  "homepage": "https://github.com/heliacn/material-symbols-framework/tree/main/packages/angular-svg#readme",
  "publishConfig": {
    "access": "public"
  },
  "author": "heliacn",
  "keywords": [
    "icons",
    "material-symbols",
    "material-design",
    "icon-library",
    "angular",
    "angular-svg"
  ]
}

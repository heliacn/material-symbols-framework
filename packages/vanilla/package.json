{
  "name": "@material-symbols-framework/vanilla",
  "version": "0.0.2",
  "description": "Material Symbols icon library for vanilla JS / Web Components.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/esm/auto-register.js"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./auto-register": {
      "import": "./dist/esm/auto-register.js"
    },
    "./style.css": "./dist/style.css",
    "./fonts/*": "./dist/fonts/*",
    "./rounded.css": "./dist/rounded.css",
    "./outlined.css": "./dist/outlined.css",
    "./sharp.css": "./dist/sharp.css"
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heliacn/material-symbols-framework.git",
    "directory": "packages/vanilla"
  },
  "bugs": {
    "url": "https://github.com/heliacn/material-symbols-framework/issues"
  },
  "homepage": "https://github.com/heliacn/material-symbols-framework/tree/main/packages/vanilla#readme",
  "publishConfig": {
    "access": "public"
  },
  "author": "heliacn",
  "keywords": [
    "icons",
    "material-symbols",
    "material-design",
    "icon-library",
    "vanilla"
  ]
}

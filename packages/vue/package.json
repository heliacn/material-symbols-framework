{
  "name": "@material-symbols-framework/vue",
  "version": "0.0.1",
  "description": "Material Symbols icon components for Vue 3.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./fonts/*": "./dist/fonts/*",
    "./rounded.css": "./dist/rounded.css",
    "./outlined.css": "./dist/outlined.css",
    "./sharp.css": "./dist/sharp.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist src/icons src/icons.ts src/index.ts",
    "generate": "node ../../scripts/generate.mjs vue",
    "build": "node build.mjs"
  },
  "peerDependencies": {
    "vue": ">=3.2"
  },
  "devDependencies": {
    "@vue/server-renderer": "^3.5.34",
    "vue": "^3.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heliacn/material-symbols-framework.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/heliacn/material-symbols-framework/issues"
  },
  "homepage": "https://github.com/heliacn/material-symbols-framework/tree/main/packages/vue#readme",
  "publishConfig": {
    "access": "public"
  },
  "author": "heliacn",
  "keywords": [
    "icons",
    "material-symbols",
    "material-design",
    "icon-library",
    "vue"
  ]
}

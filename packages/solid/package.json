{
  "name": "@material-symbols-framework/solid",
  "version": "0.0.2",
  "description": "Material Symbols icon components for SolidJS.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "solid": "./dist/source/index.jsx",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./fonts/*": "./dist/fonts/*",
    "./rounded.css": "./dist/rounded.css",
    "./outlined.css": "./dist/outlined.css",
    "./sharp.css": "./dist/sharp.css"
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist src/icons src/icons.ts src/index.ts",
    "generate": "node ../../scripts/generate.mjs solid",
    "build": "node build.mjs"
  },
  "peerDependencies": {
    "solid-js": ">=1.7"
  },
  "devDependencies": {
    "solid-js": "^1.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heliacn/material-symbols-framework.git",
    "directory": "packages/solid"
  },
  "bugs": {
    "url": "https://github.com/heliacn/material-symbols-framework/issues"
  },
  "homepage": "https://github.com/heliacn/material-symbols-framework/tree/main/packages/solid#readme",
  "publishConfig": {
    "access": "public"
  },
  "author": "heliacn",
  "keywords": [
    "icons",
    "material-symbols",
    "material-design",
    "icon-library",
    "solid"
  ]
}

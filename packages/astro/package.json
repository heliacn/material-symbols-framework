{
  "name": "@material-symbols-framework/astro",
  "version": "0.0.4",
  "description": "Material Symbols icon components for Astro.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./style.css": "./dist/style.css",
    "./fonts/*": "./dist/fonts/*",
    "./rounded.css": "./dist/rounded.css",
    "./outlined.css": "./dist/outlined.css",
    "./sharp.css": "./dist/sharp.css"
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist src/icons src/icons.js src/index.js",
    "generate": "node ../../scripts/generate.mjs astro",
    "build": "node build.mjs"
  },
  "peerDependencies": {
    "astro": ">=4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heliacn/material-symbols-framework.git",
    "directory": "packages/astro"
  },
  "bugs": {
    "url": "https://github.com/heliacn/material-symbols-framework/issues"
  },
  "homepage": "https://github.com/heliacn/material-symbols-framework/tree/main/packages/astro#readme",
  "publishConfig": {
    "access": "public"
  },
  "author": "heliacn",
  "keywords": [
    "icons",
    "material-symbols",
    "material-design",
    "icon-library",
    "astro"
  ]
}

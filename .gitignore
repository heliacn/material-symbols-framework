# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/

# Generated source (di-generate dari ms/ saat build CI / release)
# Tidak di-commit karena: 1) bisa di-regenerate dari ms/  2) repo size lebih kecil
packages/*/src/icons/
packages/*/src/icons.ts
packages/*/src/index.ts
packages/*/src/outlined/
packages/*/src/rounded/
packages/*/src/sharp/

# Un-ignore manual sources for packages without a generator step.
# vanilla & angular ship a single hand-written <ms-icon> component;
# vanilla-svg & angular-svg have a hand-written index.ts that re-exports
# the registry helpers (the per-icon data files under src/icons/{variant}/
# are still generated and stay ignored).
!packages/vanilla/src/index.ts
!packages/vanilla-svg/src/index.ts
!packages/angular/src/index.ts
!packages/angular-svg/src/index.ts

# Bundle measurement outputs
.bundle-measure/
.workers-measure/

# Internal dev notes (catatan kerja, flow handoff, knowledge base)
.dev/

# IDE / Editor
.vscode/
.idea/
.cursor/
.kiro/
.antigravity/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Cache
.cache/
.vite/
.turbo/

# Env / secrets
.env
.env.local
.env.*.local
*.pem

# pnpm specific
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
